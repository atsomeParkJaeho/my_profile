# ────────────────────────────────────────
# .env.example — 환경변수 템플릿 (git 추적 대상)
# 실제 사용 시 .env.dev 또는 .env.prod 를 .env 로 복사하세요.
# ────────────────────────────────────────

NODE_ENV=development
PORT=3000

# SQLite (DB_HOST 미설정 시 자동 사용)
DB_PATH=db.sqlite

# MariaDB (DB_HOST 설정 시 자동 사용)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=appuser
# DB_PASS=apppass
# DB_NAME=appdb
