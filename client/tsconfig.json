{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*":        ["src/*"],
      "@api/*":     ["src/api/*"],
      "@store/*":   ["src/store/*"],
      "@pages/*":   ["src/pages/*"],
      "@styles/*":  ["src/styles/*"],
      "@components/*": ["src/componet/*"]
    }
  },
  "include": ["src"]
}
